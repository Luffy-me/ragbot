# Application
APP_NAME=University Knowledge AI
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
POSTGRES_USER=uni_ai
POSTGRES_PASSWORD=uni_ai_secret
POSTGRES_DB=university_ai
DATABASE_URL=postgresql+asyncpg://uni_ai:uni_ai_secret@postgres:5432/university_ai

# CORS
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25

# Seed admin (created on startup if missing)
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=Admin123!
STUDENT_EMAIL=student@university.edu
STUDENT_PASSWORD=Student123!
